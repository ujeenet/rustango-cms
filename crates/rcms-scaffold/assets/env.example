# SQLite (the default build): the registry file; each site gets its own.
DATABASE_URL=sqlite:./var/registry.db?mode=rwc

# PostgreSQL (build with --no-default-features --features postgres):
# DATABASE_URL=postgres://localhost/__NAME__

# Production (see the README's "Deploy" section):
# RUSTANGO_ENV=prod                  # secure cookies; a missing session secret stops the boot
# RUSTANGO_SESSION_SECRET=           # signs logins — openssl rand -base64 32
# RUSTANGO_SECRET_KEY=               # encrypts stored secrets (form email recipients)
# RCMS_SECRET_KEY=                   # signs previews and password resets — same on every server
# RUSTANGO_APEX_DOMAIN=example.com
# RUSTANGO_BIND=127.0.0.1:8080
# RCMS_SITE_DIR=/srv/__NAME__        # where templates/ and migrations/ are, if not next to the source
