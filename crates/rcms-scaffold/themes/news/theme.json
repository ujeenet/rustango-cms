            {
              "key": "culture-1",
              "type": "Article",
              "title": "The return of the reading club",
              "slug": "reading-clubs",
              "seo_description": "Libraries report record sign-ups for monthly book groups.",
              "in_menu": true,
              "data": {
                "standfirst": "Libraries report record sign-ups for monthly book groups.",
                "published": "2026-10-29",
                "author": "Jo Becker",
                "featured": true,
                "body": [
                  {
                    "type": "rich_text",
                    "value": {
                      "body": "<p>Book clubs are filling library rooms again, often with long waiting lists.</p><p>Members say the conversation matters more than the book.</p>"
                    }
                  },
                  {
                    "type": "quote",
                    "value": {
                      "text": "Reading alone is a pleasure; reading together is a community.",
                      "attribution": "Jo Becker"
                    }
                  },
                  {
                    "type": "rich_text",
                    "value": {
                      "body": "<p>Many groups now meet both in person and online.</p>"
                    }
                  }
                ],
                "cover": "@media:books"
              }
            }
          ]
        },
