/target
/examples/*/target
**/*.rs.bk
.env
.env.*
!.env.example
.DS_Store
# rustango persists per-process session secrets here on first runserver boot
# (the e2e harness boots from e2e/, so it gets its own copy).
/var
/e2e/var/
.playwright-mcp/
prefs-*.png
# The framework materializes its bootstrap migrations here on first boot
# (rustango_users / roles / audit log). Generated, not source.
/system/

# Local docs-prep drafts (cookbook outline and chapter notes) — working notes, not source.
/.claude/docs-inventory/

# Local cargo overrides (e.g. the [patch] onto a sibling rustango checkout —
# see .cargo/config.toml.example).
/.cargo/config.toml

# Per-user AI-assistant permissions. Pre-approving commands is a personal
# choice, not something a clone should inherit.
/.claude/settings.json
