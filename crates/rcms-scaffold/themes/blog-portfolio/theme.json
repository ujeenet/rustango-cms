                "year": "2025",
                "services": "Product design, iOS, Android",
                "body": [
                  {
                    "type": "rich_text",
                    "value": {
                      "body": "<h2>The challenge</h2><p>Researchers needed to capture notes, photos and locations without a signal.</p>"
