                "year": "2025",
                "services": "Signage, Print",
                "body": [
                  {
                    "type": "rich_text",
                    "value": {
                      "body": "<h2>The challenge</h2><p>Visitors kept getting lost between the five floors and two entrances.</p>"
                    }
                  },
                  {
                    "type": "rich_text",
                    "value": {
                      "body": "<h2>What we did</h2><p>We created a colour-coded signage system and printed and digital maps.</p>"
